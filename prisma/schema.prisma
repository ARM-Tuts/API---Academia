generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Aluno {
  id         Int      @id @default(autoincrement())
  nome       String
  telefone   String
  modalidade String
  vencimento DateTime
  ativo      Boolean  @default(true)
}

model Professor {
  id    Int    @id @default(autoincrement())
  email String @unique
  senha String
}